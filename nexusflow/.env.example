NODE_ENV=development
PORT=3001
WS_PORT=3002
DB_PATH=./nexusflow.db

# REQUIRED: Generate secure secrets with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-secret-at-least-32

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

WORKER_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=3

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
